{
  "name": "carrygo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "rider-mobile:install": "npm --prefix rider-mobile install",
    "rider-mobile:start": "npm --prefix rider-mobile run start",
    "rider-mobile:android": "npm --prefix rider-mobile run android",
    "rider-mobile:ios": "npm --prefix rider-mobile run ios",
    "passenger-mobile:install": "npm --prefix passenger-mobile install",
    "passenger-mobile:start": "npm --prefix passenger-mobile run start",
    "passenger-mobile:android": "npm --prefix passenger-mobile run android",
    "passenger-mobile:ios": "npm --prefix passenger-mobile run ios",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "^15.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
