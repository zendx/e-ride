{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "cyber-rydes",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "cyber-rydes",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "cyber-rydes",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com"
      }
    },
    "cyber-rydes": {
      "distribution": "store",
      "channel": "cyber-rydes",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Cyber Rydes",
        "EXPO_PUBLIC_APP_SLUG": "cyber-rydes",
        "EXPO_PUBLIC_TENANT_SLUG": "cyber-rydes",
        "EXPO_PUBLIC_ANDROID_PACKAGE": "com.carrygo.cyberrydes",
        "EXPO_PUBLIC_IOS_BUNDLE_ID": "com.carrygo.cyberrydes",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.example.com"
      }
    }
  }
}
